# --- Xcode / Swift / macOS ---------------------------------------------------
build/
DerivedData/
# `dir/*` not `dir/`: git cannot re-include a file whose parent directory is
# excluded, so the negations below only work with the `/*` form.
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/
xcuserdata/
*.xcuserstate
*.xcuserdatad
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive
